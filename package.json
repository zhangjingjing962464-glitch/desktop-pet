{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "桌面小小英雄：基于 Electron + Three.js 的桌面宠物应用",
  "author": "chin.jing1998",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "scripts:link-models": "node scripts/link-models.mjs",
    "scripts:manifest": "node scripts/build-manifest.mjs",
    "scripts:inspect": "node scripts/inspect-glb.mjs --all",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "electron-store": "^10.0.1",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.12.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.3"
  },
  "build": {
    "appId": "com.chinjing.desktop-pet",
    "productName": "desktop-pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron",
      "dist",
      "assets/manifest"
    ],
    "extraResources": [
      {
        "from": "assets/models",
        "to": "models"
      },
      {
        "from": "assets/icons",
        "to": "icons"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}
